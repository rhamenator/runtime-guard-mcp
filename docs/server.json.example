{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rhamenator/runtime-guard-mcp",
  "title": "Runtime Guard MCP",
  "description": "Advisory runtime safety tools for coding agents",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/rhamenator/runtime-guard-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "runtime-guard-mcp",
      "version": "0.1.0",
      "transport": {"type": "stdio"},
      "environmentVariables": [
        {
          "name": "RUNTIME_GUARD_WORKSPACE_ROOT",
          "description": "Absolute workspace path to assess",
          "isRequired": true,
          "isSecret": false
        }
      ]
    }
  ]
}
